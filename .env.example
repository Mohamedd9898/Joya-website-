# Optional locally: omit DATABASE_URL to use persistent embedded PostgreSQL in .data/postgres.
# Production: use a dedicated PostgreSQL database. Keep credentials in a secret manager.
DATABASE_URL=
PGSSL=require
REQUIRE_EXTERNAL_DATABASE=false
# Set the real HTTPS origin before enabling indexing and publishing.
SITE_URL=
COOKIE_SECURE=false
# Used only by `npm run admin:create`, never embedded into the client bundle.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: force read-only frontend previews locally. Vercel without DATABASE_URL enables this automatically.
JOYA_FRONTEND_PREVIEW=false
